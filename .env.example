# --- Core ---
MODEL_PROVIDER=local
LOCAL_LLM_BACKEND=transformers
LOCAL_LLM_MODEL=Qwen/Qwen3-14B
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
FAST_LLM_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda

# --- SEC Fair Access: set BOTH before downloading ---
SEC_USER_AGENT=FilingsGraph research-project your-name your-email@example.com
SEC_CONTACT_EMAIL=your-email@example.com
SEC_REQUESTS_PER_SECOND=5
SEC_TIMEOUT_SECONDS=45
SEC_MAX_RETRIES=5

# --- Storage ---
QDRANT_MODE=local
QDRANT_URL=
QDRANT_PATH=data/index/qdrant
DATABASE_MODE=duckdb
DATABASE_URL=data/processed/filingsgraph.duckdb
GRAPH_MODE=networkx
GRAPH_PATH=data/graph/filingsgraph.json

# Optional infrastructure
POSTGRES_URL=postgresql+psycopg://filingsgraph:filingsgraph@localhost:5432/filingsgraph
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Optional macro data
ENABLE_FRED=false
FRED_API_KEY=

# Optional commercial providers (disabled by default)
ENABLE_COMMERCIAL_MODELS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
